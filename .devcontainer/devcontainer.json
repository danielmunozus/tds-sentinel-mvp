{
  "name": "TDS Sentinel MVP",
  "image": "ghcr.io/cirruslabs/flutter:stable",

  "forwardPorts": [5000, 8080],

  "portsAttributes": {
    "5000": {
      "label": "Sentinel API",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Flutter Web",
      "onAutoForward": "notify"
    }
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "Dart-Code.flutter",
        "Dart-Code.dart-code"
      ]
    }
  }
}
